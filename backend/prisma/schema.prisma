// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// 用户表 (users)
model User {
  id        Int       @id @default(autoincrement())
  username  String    @unique @db.VarChar(50)
  password  String    @db.VarChar(255)
  role      String    @default("admin") @db.VarChar(20)
  status    Int       @default(1) @db.TinyInt
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // 关联：用户操作的库存交易记录
  inventoryTransactions InventoryTransaction[]

  // 索引优化：软删除字段用于过滤已删除记录
  @@index([deletedAt], name: "idx_users_deleted_at")
  @@map("users")
}

// 商品分类表 (categories)
model Category {
  id        Int       @id @default(autoincrement())
  name      String    @db.VarChar(100)
  parentId  Int?      @map("parent_id")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // 自引用关系：父分类
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")

  // 关联：分类下的商品
  products Product[]

  // 索引优化：父分类ID用于分类树查询
  @@index([parentId], name: "idx_categories_parent_id")
  // 索引优化：软删除字段用于过滤已删除记录
  @@index([deletedAt], name: "idx_categories_deleted_at")
  @@map("categories")
}

// 商品表 (products)
model Product {
  id           Int       @id @default(autoincrement())
  sku          String    @unique @db.VarChar(50)
  name         String    @db.VarChar(200)
  categoryId   Int       @map("category_id")
  unit         String    @db.VarChar(20)
  quantity     Int       @default(0)
  minThreshold Int       @default(10) @map("min_threshold")
  costPrice    Decimal?  @map("cost_price") @db.Decimal(10, 2)
  salePrice    Decimal?  @map("sale_price") @db.Decimal(10, 2)
  version      Int       @default(1)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  // 关联：商品所属分类
  category Category @relation(fields: [categoryId], references: [id])

  // 关联：商品的库存交易记录
  inventoryTransactions InventoryTransaction[]

  // 索引优化：分类ID用于分类筛选查询
  @@index([categoryId], name: "idx_products_category_id")
  // 索引优化：软删除字段用于过滤已删除记录
  @@index([deletedAt], name: "idx_products_deleted_at")
  // 复合索引：用于低库存查询优化
  @@index([deletedAt, quantity, minThreshold], name: "idx_products_low_stock")
  @@map("products")
}

// 供应商表 (suppliers)
model Supplier {
  id        Int       @id @default(autoincrement())
  code      String    @unique @db.VarChar(50)
  name      String    @db.VarChar(200)
  contact   String?   @db.VarChar(100)
  phone     String?   @db.VarChar(20)
  address   String?   @db.VarChar(500)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // 关联：供应商的入库记录
  inventoryTransactions InventoryTransaction[]

  // 索引优化：软删除字段用于过滤已删除记录
  @@index([deletedAt], name: "idx_suppliers_deleted_at")
  @@map("suppliers")
}

// 库存交易类型枚举
enum TransactionType {
  IN
  OUT
  ADJUSTMENT
}

// 库存交易表 (inventory_transactions)
// 注：作为审计日志，不支持软删除
model InventoryTransaction {
  id             Int             @id @default(autoincrement())
  type           TransactionType
  productId      Int             @map("product_id")
  sku            String          @db.VarChar(50)
  quantity       Int
  quantityBefore Int             @map("quantity_before")
  quantityAfter  Int             @map("quantity_after")
  supplierId     Int?            @map("supplier_id")
  operatorId     Int             @map("operator_id")
  remark         String?         @db.VarChar(500)
  createdAt      DateTime        @default(now()) @map("created_at")

  // 关联：交易涉及的商品
  product Product @relation(fields: [productId], references: [id])

  // 关联：供应商（入库时）
  supplier Supplier? @relation(fields: [supplierId], references: [id])

  // 关联：操作人
  operator User @relation(fields: [operatorId], references: [id])

  // 索引优化：交易类型用于入库/出库记录筛选
  @@index([type], name: "idx_inventory_transactions_type")
  // 索引优化：创建时间用于时间范围查询和排序
  @@index([createdAt], name: "idx_inventory_transactions_created_at")
  // 索引优化：商品ID用于商品交易记录查询
  @@index([productId], name: "idx_inventory_transactions_product_id")
  // 复合索引：用于按类型和时间范围查询（仪表盘今日统计）
  @@index([type, createdAt], name: "idx_inventory_transactions_type_created_at")
  // 索引优化：供应商ID用于供应商入库记录查询
  @@index([supplierId], name: "idx_inventory_transactions_supplier_id")
  @@map("inventory_transactions")
}
